<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.child.WpChild">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/wp_name_lay"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <AutoCompleteTextView
            android:id="@+id/wp_child_name"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/name"
            android:inputType="textPersonName|textCapWords" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/wp_wt_lay"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginLeft="8dp"
        app:helperTextEnabled="true"
        app:helperText="@string/wt"
        app:endIconMode="custom"
        app:endIconDrawable="@drawable/ic_newborn"
        android:layout_weight=".25"
        app:layout_constraintEnd_toStartOf="@id/wp_ht_lay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/wp_ht_lay">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/wp_txtWt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/kg"
            android:inputType="textFilter|numberDecimal"
            android:selectAllOnFocus="true"
            android:maxLength="6"
            android:singleLine="true"
            android:nextFocusLeft="@+id/wp_txtHt"
            android:nextFocusDown="@+id/wp_txtHt"/>

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/wp_ht_lay"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:endIconMode="custom"
        app:helperTextEnabled="true"
        app:helperText="@string/ht"
        app:prefixText="H "
        app:endIconContentDescription="Height"
        android:layout_weight=".5"
        app:layout_constraintEnd_toStartOf="@+id/wp_chip"
        app:layout_constraintStart_toEndOf="@id/wp_wt_lay"
        app:layout_constraintTop_toBottomOf="@+id/wp_name_lay">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/wp_txtHt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/cm"
            android:inputType="textFilter|number|numberDecimal"
            android:maxLength="5"
            android:singleLine="true"
            android:selectAllOnFocus="true"
            android:nextFocusLeft="@+id/wp_chip"
            android:nextFocusDown="@+id/wp_chip"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.chip.Chip
        android:id="@+id/wp_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginRight="8dp"
        android:text="@string/add"
        app:closeIcon="@android:drawable/ic_menu_close_clear_cancel"
        app:closeIconVisible="true"
        app:layout_constraintBottom_toTopOf="@+id/wp_child_pager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/wp_ht_lay"
        app:layout_constraintTop_toBottomOf="@+id/wp_name_lay" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/wp_child_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@id/add_lay"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wp_wt_lay"
        app:layout_constraintVertical_bias="0.0" />
    <include
        android:id="@+id/add_lay"
        layout="@layout/my_banner_ad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>