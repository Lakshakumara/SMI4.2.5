<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginRight="8dp"
        android:orientation="horizontal"
        android:weightSum="10">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="4">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/yy"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:hint="@string/dob_yyyy"
                android:inputType="number"
                android:maxLength="4"
                android:nextFocusLeft="@+id/mm"
                android:nextFocusDown="@+id/mm"
                android:selectAllOnFocus="true"
                android:textStyle="bold"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:freezesText="false"
            android:gravity="center_horizontal|center_vertical"
            android:text="@string/dobSep" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="2">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/mm"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical|center_horizontal"
                android:hint="@string/mm"
                android:inputType="number"
                android:maxLength="2"
                android:nextFocusLeft="@+id/dd"
                android:nextFocusDown="@+id/dd"
                android:selectAllOnFocus="true"
                android:textStyle="bold"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:freezesText="false"
            android:gravity="center_horizontal|center_vertical"
            android:text="@string/dobSep" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="2">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dd"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical|center_horizontal"
                android:hint="@string/dd"
                android:inputType="number"
                android:maxLength="2"
                android:nextFocusLeft="@+id/wp_txtWt"
                android:nextFocusDown="@+id/wp_txtWt"
                android:selectAllOnFocus="true"
                android:textStyle="bold"/>
        </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>